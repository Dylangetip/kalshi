# Reference receiver config. Copy to .env (or export directly).

# Bearer token the extension must send (Authorization: Bearer <token>).
# In production this is the parent's platform session token. Leave empty to
# DISABLE auth — dev only, never in production.
API_TOKEN=change-me

# Optional: where to write the SQLite db (defaults to ./captures.db)
# CAPTURES_DB=/var/data/captures.db
