# Copy this file to backend/.env and fill in your values.
# backend/.env is gitignored — never commit your real credentials.

# Kalshi API base. Use the demo endpoint while testing —
# it gives you a separate paper-trading account with fake money.
#   Demo:        https://demo-api.kalshi.co/trade-api/v2
#   Production:  https://trading-api.kalshi.com/trade-api/v2
KALSHI_API_BASE=https://demo-api.kalshi.co/trade-api/v2

# Email + password for the Kalshi account.
KALSHI_EMAIL=
KALSHI_PASSWORD=
