# Copy this file to backend/.env and fill in your values.
# backend/.env is gitignored — never commit your real credentials.

# Kalshi REST API base. As of late 2024 everything (incl. weather
# markets) lives under api.elections.kalshi.com.
KALSHI_API_BASE=https://api.elections.kalshi.com/trade-api/v2

# RSA API key auth — the only auth method Kalshi supports today.
# To generate one:
#   1. Log in at https://kalshi.com
#   2. Account → Settings → API Keys → "Create new key"
#   3. Save the private key file shown (this is the only time it's displayed)
#   4. Copy the Key ID into KALSHI_API_KEY_ID below
#   5. Save the .pem file somewhere safe (e.g. ~/kalshi/backend/kalshi.pem)
#      and put its absolute path in KALSHI_API_KEY_PEM_PATH below
KALSHI_API_KEY_ID=
KALSHI_API_KEY_PEM_PATH=
